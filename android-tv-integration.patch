+fun FullDetailsFragment.discoverEpisodeComments() {
+	val api by inject<ApiClient>()
+	val itemId = mBaseItem.id
+	val button = commentsButton ?: return
+	viewLifecycleOwner.lifecycleScope.launch {
+		setEpisodeCommentsAvailable(itemId, button, EpisodeCommentsApi(api).isAvailable())
+	}
+}
+
+fun FullDetailsFragment.openEpisodeComments() {
+	val api by inject<ApiClient>()
+	val item = mBaseItem
+	val button = commentsButton ?: return
+	viewLifecycleOwner.lifecycleScope.launch {
+		// Recheck on selection in case the plugin was removed while details stayed open.
+		val available = EpisodeCommentsApi(api).isAvailable()
+		if (mBaseItem.id != item.id || commentsButton !== button) return@launch
+		setEpisodeCommentsAvailable(item.id, button, available)
+		if (available) EpisodeCommentsDialogFragment.show(parentFragmentManager, item)
+		else Toast.makeText(requireContext(), R.string.episode_comments_unavailable, Toast.LENGTH_SHORT).show()
+	}
+}
